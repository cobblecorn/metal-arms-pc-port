// Windows resources for ma_setup.exe: the game icon and version details.
#include <winver.h>

1 ICON "../res/ma_port.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,7,0
 PRODUCTVERSION 1,0,7,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Metal Arms PC port setup (extracts game files from your own disc)"
            VALUE "FileVersion", "1.0.7.0"
            VALUE "InternalName", "ma_setup"
            VALUE "OriginalFilename", "ma_setup.exe"
            VALUE "ProductName", "Metal Arms PC port"
            VALUE "ProductVersion", "1.0.7.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
