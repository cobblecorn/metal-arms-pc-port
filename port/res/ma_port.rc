// Windows resources for ma_port.exe.
#include "resource.h"

// The game icon (Explorer, the title bar and the taskbar); 16 to 256 pixels.
IDI_MA_PORT ICON "ma_port.ico"

#include <winver.h>

// Version details (Explorer's Properties > Details); keep in step with port/setup/ma_setup.rc.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,11,0
 PRODUCTVERSION 1,0,11,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Metal Arms: Glitch in the System (PC port)"
            VALUE "FileVersion", "1.0.11.0"
            VALUE "InternalName", "ma_port"
            VALUE "OriginalFilename", "ma_port.exe"
            VALUE "ProductName", "Metal Arms PC port"
            VALUE "ProductVersion", "1.0.11.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
