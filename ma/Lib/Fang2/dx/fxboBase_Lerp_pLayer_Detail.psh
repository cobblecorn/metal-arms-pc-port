;
; Pixel shader 

; Declare pixel shader version 1.1
ps.1.1

def c0, 0.5, 0.5, 0.5, 0.5

tex t0              ; decal texture
tex t1
tex t2				; detail texture

add r1.rgb, t2, c0
mov r0, t0
mul r1.a, v0.a, t1.a
mul r1.a, r1.a, c3.a
lrp r0.rgb, r1.a, t1, r0
mul r0.rgb, r0, r1
mul r0, r0, c2

;mov r0, c0