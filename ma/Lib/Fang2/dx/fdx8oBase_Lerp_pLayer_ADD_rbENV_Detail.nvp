;
; Pixel shader 

; Declare pixel shader version 1.1
ps.1.1

def c0, 0.5, 0.5, 0.5, 0.5

tex t0              ; decal texture
tex t1				; layer
tex t2				; envmap
tex t3				; detail texture

mov r1.rgb, t1
+mul r1.a, t1.a, c3.a
mul r1.a, r1.a, v0.a
lrp r0, r1.a, r1, t0

mul r1.rgb, t2, t0.a
mad r0.rgb, r1, v1, r0
;add r0.rgb, r0, r1

add r1, t3, c0
mul r0, r0, r1
mul r0, r0, c2		; res *= surface color
