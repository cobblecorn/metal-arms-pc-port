;
; Pixel shader 

; Declare pixel shader version 1.1
ps.1.1

def c3, 0, 1, 0, 0	; use the green component of the shadow buffer for the compare.

tex t0              ; Spot Texture
tex t1				; Clip
tex t2				; Shadow Map

;const c0 = shadowID

dp3 r1, t2, c3	;this will be the shadowID in the map.

sub_x4_sat r0, c0, r1
sub_x4_sat r1, r1, c0
add_x4_sat r0.a, r0, r1

mul_sat r0.rgb, t0, v0
+mov r0.a, 1-r0.a
mul_sat r0.rgb, r0, 1-t1
