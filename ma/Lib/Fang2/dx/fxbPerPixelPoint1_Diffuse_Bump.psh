;
; Pixel shader 

; Declare pixel shader version 1.1
ps.1.1

def c0, 1, 1, 1, 1

tex t0              ; XZ attenuation
tex t1				; Y attenuation
tex t2
tex t3

mul r1, v0, 1-t0
mad r0, v0, t1, -r1
mul r0, r0_sat, r0_sat
mul r0, r0, r0
dp3 r1, t3_bx2, t2_bx2
mul r0, r0_sat, r1_sat
