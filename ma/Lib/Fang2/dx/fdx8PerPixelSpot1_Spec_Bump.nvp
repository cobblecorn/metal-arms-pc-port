;
; Pixel shader 

; Declare pixel shader version 1.1
ps.1.1

def c0, 1, 1, 1, 1

tex t0              ; Spot Texture
tex t1				; Clip
tex t2				; bumpmap
tex t3				; H Vector (cubemap normalized)

mov r1, t3
dp3_sat r1, r1_bx2, t2_bx2	;N'.H

mul_sat r0.rgb, t0, v0
+mul_sat r1.a, r1, r1	;x^2
mul_sat r0.rgb, r0, 1-t1
+mul r1.a, r1.a, r1.a		;x^4
;mul r1.a, r1.a, r1.a		;x^8
;mul r1.a, r1.a, r1.a		;x^16
;mul r1.a, r1.a, r1.a		;x^32

mul r0.rgb, r0, r1.a		;SpotTexture * Clip * (N'.H)^32
;mov r0.rgb, t3
+mov r0.a, c0.a				; alpha = 1.0f
