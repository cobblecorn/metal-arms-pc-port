;
; Pixel shader 

; Declare pixel shader version 1.1
ps.1.1

def c0, 0.5, 0.5, 0.5, 0.5

tex t0              ; decal texture
tex t1
tex t2				; detail texture

;add r0, t2, c0
;mul r0.rgb, r0, t0
;+mov r0.a, t0.a
;mov r1.rgb, t1
;+mul r1.a, t1.a, c3.a
;lrp r0.rgb, r1.a, r1, r0
;mul r0, r0, c2		; res *= surface color

mov r0, t0
mov r1.rgb, t1
+mul r1.a, t1.a, c3.a
lrp r0.rgb, r1.a, r1, r0
add r1, t2, c0
mul r0, r0, r1
mul r0, r0, c2		; res *= surface color