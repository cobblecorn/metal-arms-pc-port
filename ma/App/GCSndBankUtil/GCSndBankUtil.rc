/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON    DISCARDABLE     "res\\GCSndBankUtil.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 194, 61
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About GCSndBankUtil"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "GCSndBankUtil Version 1.0",IDC_STATIC,40,10,147,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 2002, Swingin' Ape Studios, Inc.",
                    IDC_STATIC,40,25,147,8
    DEFPUSHBUTTON   "OK",IDOK,72,40,50,14,WS_GROUP
END

IDD_GCSNDBANKUTIL_DIALOG DIALOGEX 0, 0, 355, 306
STYLE DS_MODALFRAME | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | 
    WS_SYSMENU
EXSTYLE WS_EX_ACCEPTFILES | WS_EX_APPWINDOW
CAPTION "GameCube Sound Bank Conversion Utility"
FONT 8, "MS Sans Serif"
BEGIN
    PUSHBUTTON      "&Exit",IDCANCEL,185,283,54,16
    CONTROL         "List3",IDC_BANK_FILE_LIST,"SysListView32",LVS_REPORT | 
                    LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,7,33,341,93
    RTEXT           "Version # 17",IDC_VERSION,286,293,65,8
    LTEXT           "Instructions: Drop the required files and folder onto the application and press the 'Convert' button.",
                    IDC_STATIC,7,7,341,8
    PUSHBUTTON      "&Convert",IDC_CONVERT_BUTTON,116,283,54,16
    PUSHBUTTON      "...",IDC_CHOOSE_OUTPUT_DIR,337,262,11,12
    EDITTEXT        IDC_OUTPUT_DIR,7,261,327,14,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Output Directory:",IDC_STATIC,7,251,79,8
    LTEXT           "Sound Bank Files: ( *.wvb )",IDC_STATIC,7,23,341,8
    CONTROL         "List3",IDC_MUSYX_FILE_LIST,"SysListView32",LVS_REPORT | 
                    LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,7,147,341,93
    LTEXT           "MusyX Files: ( *.proj *.samp *.h *.pool *.sdir )",
                    IDC_STATIC,7,137,341,8
END


