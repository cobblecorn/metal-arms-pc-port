IDR_MAINFRAME           ICON    DISCARDABLE     "res\\SndSeqBanker.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 235, 55
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About SndSeqBanker"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "SndSeqBanker Version 1.0",IDC_STATIC,40,10,119,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 2002",IDC_STATIC,40,25,119,8
    DEFPUSHBUTTON   "OK",IDOK,178,7,50,14,WS_GROUP
END

IDD_SNDSEQBANKER_DIALOG DIALOGEX 0, 0, 353, 334
STYLE DS_MODALFRAME | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | 
    WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Sound Sequence Banker"
FONT 8, "MS Sans Serif"
BEGIN
    PUSHBUTTON      "...",IDC_CHOOSE_CURRENT_SEQ_BANK,333,8,12,14
    CONTROL         "List3",IDC_SEQ_BANK_LIST,"SysListView32",LVS_REPORT | 
                    LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | 
                    WS_TABSTOP,8,26,280,112
    PUSHBUTTON      "&Create Bank",IDC_CREATE_NEW_BANK,291,28,54,14
    CONTROL         "List3",IDC_WAV_BANK_LIST,"SysListView32",LVS_REPORT | 
                    LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,8,184,338,112
    PUSHBUTTON      "&Exit",IDCANCEL,152,313,50,14
    EDITTEXT        IDC_CURRENT_WAV_BANK,105,166,241,14,ES_AUTOHSCROLL | 
                    ES_READONLY
    RTEXT           "Current Wav Bank:",IDC_STATIC,8,169,95,8
    RTEXT           "Version # 17",IDC_VERSION,283,322,65,8
    LTEXT           "36 object(s)",IDC_NUM_WAV_BANK_FILES,9,298,97,8
    EDITTEXT        IDC_CURRENT_SEQ_BANK,105,8,224,14,ES_AUTOHSCROLL | 
                    ES_READONLY
    RTEXT           "Current Sequence Bank:",IDC_STATIC,8,11,95,8
    LTEXT           "36 object(s)",IDC_NUM_SEQ_BANK_FILES,10,140,97,8
    LTEXT           "----------------------------------------------------------------------------------------------------------------------------------------------------------------",
                    IDC_STATIC,15,154,323,8
    PUSHBUTTON      "Verify Names",IDC_CHECK_SFX_NAMES,291,48,54,14
END

IDD_EDIT_FX_DIALOG DIALOG DISCARDABLE  0, 0, 273, 120
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION
CAPTION "Edit Fx - Blah Blah"
FONT 8, "MS Sans Serif"
BEGIN
    EDITTEXT        IDC_FX_NAME,114,5,75,12,ES_AUTOHSCROLL
    COMBOBOX        IDC_WAV_COMBO,114,23,75,55,CBS_DROPDOWNLIST | CBS_SORT | 
                    WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_LOOPS,114,41,40,12,ES_RIGHT | ES_AUTOHSCROLL | 
                    ES_NUMBER | WS_GROUP
    CONTROL         "Spin1",IDC_LOOP_SPIN,"msctls_updown32",UDS_SETBUDDYINT | 
                    UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | 
                    UDS_NOTHOUSANDS,150,41,10,14
    EDITTEXT        IDC_VOLUME,114,59,40,12,ES_RIGHT | ES_AUTOHSCROLL | 
                    ES_NUMBER | WS_GROUP
    CONTROL         "Spin1",IDC_VOLUME_SPIN,"msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | 
                    UDS_ARROWKEYS | UDS_NOTHOUSANDS,150,59,10,14
    EDITTEXT        IDC_PITCH,114,77,40,12,ES_RIGHT | ES_AUTOHSCROLL | 
                    WS_GROUP
    CONTROL         "Spin1",IDC_PITCH_SPIN,"msctls_updown32",UDS_SETBUDDYINT | 
                    UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | 
                    UDS_NOTHOUSANDS,150,76,10,14
    PUSHBUTTON      "OK",IDOK,79,99,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,144,99,50,14
    LTEXT           "44100 Hz\n2 channels\n01:23:46.23",IDC_WAV_INFO,200,16,
                    66,27
    RTEXT           "Sound Fx Name:",IDC_STATIC,7,7,102,8
    RTEXT           "Wav file to play:",IDC_STATIC,7,25,102,8
    RTEXT           "Number of loops ( 0 infinite ):",IDC_STATIC,7,43,102,8
    RTEXT           "Volume ( 1 to 100 ):",IDC_STATIC,7,61,102,8
    RTEXT           "Frequency % ( -1000 to 1000 ):",IDC_STATIC,7,79,102,8
END


