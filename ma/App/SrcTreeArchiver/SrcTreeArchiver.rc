/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON    DISCARDABLE     "res\\SrcTreeArchiver.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 198, 55
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About SrcTreeArchiver"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "SrcTreeArchiver Version 1.0",IDC_STATIC,40,10,151,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 2002, Swingin' Ape Studios, Inc.",
                    IDC_STATIC,40,21,151,8
    DEFPUSHBUTTON   "OK",IDOK,74,34,50,14,WS_GROUP
END

IDD_SRCTREEARCHIVER_DIALOG DIALOGEX 0, 0, 360, 207
STYLE DS_MODALFRAME | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | 
    WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Source Tree Archiver"
FONT 8, "MS Sans Serif"
BEGIN
    PUSHBUTTON      "...",IDC_BUTTON_PICK_SOURCE_TREE,337,17,10,12
    EDITTEXT        IDC_OUTPUT_FILENAME,108,32,239,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_IGNORE_EXT,108,47,239,12,ES_AUTOHSCROLL
    CONTROL         "Recurse Sub Directories",IDC_SUB_DIRS_CHECK,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,24,66,92,10
    COMBOBOX        IDC_SPAN_COMBO,148,65,83,95,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_PROFILE_COMBO,263,65,83,60,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
    CONTROL         "DateTimePicker1",IDC_DATETIMEPICKER1,"SysDateTimePick32",
                    DTS_RIGHTALIGN | DTS_SHOWNONE | WS_TABSTOP,108,124,75,15
    PUSHBUTTON      "&Start Compressing",IDC_RUN_BUTTON,140,145,80,14
    PUSHBUTTON      "&Exit",IDCANCEL,155,186,50,14
    RTEXT           "Output File:",IDC_STATIC,11,34,93,8
    RTEXT           "Source Tree:",IDC_STATIC,11,19,93,8
    EDITTEXT        IDC_SOURCE_TREE,108,17,227,12,ES_AUTOHSCROLL | 
                    ES_READONLY | NOT WS_TABSTOP
    RTEXT           "Ignore Extensions:\nThe format is:  *.ext;*.ext",
                    IDC_STATIC,11,45,93,15
    CONTROL         "Progress1",IDC_PROGRESS_BAR,"msctls_progress32",
                    WS_BORDER,7,163,346,8
    LTEXT           "Compiling 101 of 999",IDC_PROGRESS_TEXT,7,175,346,8
    GROUPBOX        "Settings:",IDC_STATIC,7,3,346,139
    RTEXT           "Backup Files Newer Than:",IDC_STATIC,11,127,93,8
    CONTROL         "Click && Go -- ( processes\nall profiles with one click )",
                    IDC_CLICK_N_GO,"Button",BS_AUTOCHECKBOX | BS_MULTILINE | 
                    WS_TABSTOP,245,122,103,17
    LTEXT           "Note: When spanning multiple disks you need to rename all files to have the same\n.zip filename.  If you do not have winzip 8.1 you will also need to copy each file onto",
                    IDC_STATIC,39,81,314,19
    LTEXT           "a removable disk labeled 'PKBACK# 00X' where X is a number starting with 1 and\nincreasing.  Look at file creation times and name the earliest disk 1, the next one 2...",
                    IDC_STATIC,39,101,314,19
END


