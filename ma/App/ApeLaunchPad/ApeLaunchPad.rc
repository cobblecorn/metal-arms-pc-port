    EDITTEXT        IDC_FONTOMATIC_LOC,60,155,201,12,ES_AUTOHSCROLL | 
                    ES_READONLY | NOT WS_TABSTOP
    RTEXT           "K9:",IDC_STATIC,11,172,44,8
