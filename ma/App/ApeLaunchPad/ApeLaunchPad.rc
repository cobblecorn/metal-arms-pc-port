IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 203, 56
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About ApeLaunchPad"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "ApeLaunchPad -- Version 1.0",IDC_STATIC,40,10,119,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 2002 Swingin' Ape Studios, Inc.",
                    IDC_STATIC,40,22,150,8
    DEFPUSHBUTTON   "OK",IDOK,77,35,50,14,WS_GROUP
END

IDD_APELAUNCHPAD_DIALOG DIALOGEX 0, 0, 344, 225
STYLE DS_MODALFRAME | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | 
    WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Ape Launch Pad"
FONT 8, "MS Sans Serif"
BEGIN
    LISTBOX         IDC_LIST,60,8,277,90,LBS_NOINTEGRALHEIGHT | LBS_NOSEL | 
                    WS_VSCROLL
    PUSHBUTTON      "...",IDC_BUTTON_PICK_COPYGO_LOC,264,110,10,12
    PUSHBUTTON      "Run CopyGo",IDC_BUTTON_RUN_COPYGO,281,109,52,14
    PUSHBUTTON      "...",IDC_BUTTON_PICK_PASM_LOC,264,125,10,12
    PUSHBUTTON      "Run PASM",IDC_BUTTON_RUN_PASM,281,124,52,14
    PUSHBUTTON      "...",IDC_BUTTON_PICK_JAWS_LOC,264,140,10,12
    PUSHBUTTON      "Run Jaws",IDC_BUTTON_RUN_JAWS,281,139,52,14
    PUSHBUTTON      "...",IDC_BUTTON_PICK_FONTOMATIC_LOC,264,155,10,12
    PUSHBUTTON      "Run Fontomatic",IDC_BUTTON_RUN_FONTOMATIC,281,154,52,14
    PUSHBUTTON      "...",IDC_BUTTON_PICK_K9_LOC,264,170,10,12
    PUSHBUTTON      "Run K9",IDC_BUTTON_RUN_K9,281,169,52,14
    PUSHBUTTON      "...",IDC_BUTTON_PICK_MAWIN_LOC,264,185,10,12
    PUSHBUTTON      "Run Mawin",IDC_BUTTON_RUN_MAWIN,281,184,52,14
    PUSHBUTTON      "&Exit",IDCANCEL,147,204,50,14
    RTEXT           "Event Log:",IDC_STATIC,11,8,44,8
    RTEXT           "PASM:",IDC_STATIC,11,127,44,8
    EDITTEXT        IDC_PASM_LOC,60,125,201,12,ES_AUTOHSCROLL | ES_READONLY | 
                    NOT WS_TABSTOP
    RTEXT           "Jaws:",IDC_STATIC,11,142,44,8
    EDITTEXT        IDC_JAWS_LOC,60,140,201,12,ES_AUTOHSCROLL | ES_READONLY | 
                    NOT WS_TABSTOP
