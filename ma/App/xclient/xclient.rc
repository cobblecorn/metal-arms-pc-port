/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_XCLIENT_DIALOG DIALOGEX 0, 0, 330, 183
STYLE WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "SAS Master File Update Client"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL         "Launch Game",IDC_CHECK_LAUNCHGAME,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,95,23,62,16
    CONTROL         "Sync Master File",IDC_CHECK_SYNCMASTER,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,162,23,72,16
    PUSHBUTTON      "&Go",IDC_BUTTON_GO,205,7,36,14
    COMBOBOX        IDC_COMBO_GAMES,71,7,127,54,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Settings",IDC_BUTTON_SETTINGS,246,7,36,14
    LTEXT           "Game To Launch",IDC_STATIC,7,9,61,11
    PUSHBUTTON      "&Quit",IDC_BUTTON_QUIT,287,7,36,14
    GROUPBOX        "Status",IDC_STATIC,7,37,316,140
    CONTROL         "",IDC_TEXT_STATUS,"RICHEDIT",ES_MULTILINE | 
                    ES_AUTOHSCROLL | WS_BORDER | WS_VSCROLL | WS_TABSTOP,13,
                    48,303,109
    CONTROL         "Progress1",IDC_PROGRESS1,"msctls_progress32",WS_BORDER,
                    13,161,304,11
END

IDD_SETTINGS DIALOG DISCARDABLE  0, 0, 307, 105
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,250,7,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,250,25,50,14
    LTEXT           "Xbox Name",IDC_STATIC,7,9,42,11
    LTEXT           "User Name",IDC_STATIC,7,26,42,11
    LTEXT           "Master File Path",IDC_STATIC,7,45,53,11
    EDITTEXT        IDC_TEXT_XBOX,63,7,92,13,ES_AUTOHSCROLL
    EDITTEXT        IDC_TEXT_USERNAME,63,25,92,13,ES_AUTOHSCROLL
    EDITTEXT        IDC_TEXT_MASTERFILE,63,44,181,13,ES_AUTOHSCROLL | 
                    ES_READONLY
    PUSHBUTTON      "Browse",IDC_BROWSE,250,43,49,15
    PUSHBUTTON      "Reboot Xbox",IDC_REBOOT,250,84,50,14
    LTEXT           "Game File Path",IDC_STATIC,7,65,53,11
    EDITTEXT        IDC_TEXT_GAMEFILE,63,64,181,13,ES_AUTOHSCROLL | 
                    ES_READONLY
    PUSHBUTTON      "Browse",IDC_BROWSE2,250,63,49,15
END


