/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON    DISCARDABLE     "res\\ApeConvert.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 178, 55
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About ApeConvert"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    DEFPUSHBUTTON   "OK",IDOK,64,34,50,14,WS_GROUP
    LTEXT           "ApeConvert, Version 1.0\nWritten by: Michael Starich\nCopyright (c) 2001, Swingin' Ape Studios, Inc.",
                    IDC_STATIC,37,7,133,28,SS_NOPREFIX
END

IDD_APECONVERT_DIALOG DIALOGEX 0, 0, 257, 223
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "ApeConvert -- Ape File Converter (c) Swingin' Ape Studios, Inc."
FONT 8, "MS Sans Serif"
BEGIN
    PUSHBUTTON      "...",IDC_CHOOSE_INPUT_FILE,240,8,10,12
    PUSHBUTTON      "Convert",IDC_CONVERT,103,26,50,14
    PUSHBUTTON      "Exit",IDCANCEL,104,202,50,14
    EDITTEXT        IDC_INPUT_NAME,65,8,173,12,ES_AUTOHSCROLL | ES_READONLY
    CONTROL         "Progress1",IDC_PROGRESS_BAR,"msctls_progress32",
                    WS_BORDER,7,47,169,8
    LTEXT           "Compiling 101 of 999",IDC_PROGRESS_TEXT,179,47,68,8
    LTEXT           "Input Filename:",IDC_STATIC,11,10,46,8
    LISTBOX         IDC_OUTPUT,7,60,243,137,NOT LBS_NOTIFY | LBS_SORT | 
                    LBS_USETABSTOPS | LBS_NOINTEGRALHEIGHT | LBS_NOSEL | 
                    WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
END


