    CONTROL         "",IDC_SLIDER1,"msctls_trackbar32",TBS_AUTOTICKS | 
                    TBS_BOTH | WS_TABSTOP,122,281,194,24
    CTEXT           "Lighting Quality:\n0: No Lighting  1: No shadows\n2-10: Increasing radiosity detail",
                    IDC_STATIC,14,276,105,28
    RTEXT           "Max. Lightmap Size (MB):",IDC_STATIC,114,315,80,12
    EDITTEXT        IDC_LMAP_MAXSIZE,196,314,32,14,ES_AUTOHSCROLL
    LTEXT           "0",IDC_STATIC,128,270,8,8
    LTEXT           "1",IDC_STATIC,146,270,8,8
    LTEXT           "2",IDC_STATIC,164,270,8,8
    LTEXT           "3",IDC_STATIC,182,270,8,8
    LTEXT           "4",IDC_STATIC,199,270,8,8
    LTEXT           "5",IDC_STATIC,217,270,8,8
    LTEXT           "6",IDC_STATIC,234,270,8,8
    LTEXT           "7",IDC_STATIC,253,270,8,8
    LTEXT           "8",IDC_STATIC,271,270,8,8
    LTEXT           "9",IDC_STATIC,288,270,8,8
    LTEXT           "10",IDC_STATIC,304,270,8,8
    RTEXT           "SubSampling (sample/ft.):\n0 = Use 3x3 filter instead",
                    IDC_STATIC,235,313,94,17
    EDITTEXT        IDC_SUBSAMPLE,331,314,31,14,ES_AUTOHSCROLL
    CONTROL         "Disable Stripping",IDC_DISABLE_STRIPPING,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,12,230,76,10
    GROUPBOX        "Development Only",IDC_STATIC,7,212,86,48
    CONTROL         "Ignore VIS (Rebuild All)",IDC_DONT_USE_VIS,"Button",
                    BS_AUTOCHECKBOX | BS_VCENTER | BS_MULTILINE | WS_TABSTOP,
                    12,306,101,11
    CONTROL         "Reuse perfect match VIS only",
                    IDC_REUSE_PERFECT_MATCH_ONLY,"Button",BS_AUTOCHECKBOX | 
                    BS_VCENTER | BS_MULTILINE | WS_TABSTOP,12,319,101,11
    CONTROL         "Detailed Lighting Info",IDC_DETAILED_LIGHTING_INFO,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,240,76,10
END

