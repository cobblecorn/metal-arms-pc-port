    PUSHBUTTON      "Local &Rescan  &&  Compile",IDC_SCAN_AND_COMPILE,261,3,
                    107,14,BS_MULTILINE
    CONTROL         "List3",IDC_FILE_LIST,"SysListView32",LVS_REPORT | 
