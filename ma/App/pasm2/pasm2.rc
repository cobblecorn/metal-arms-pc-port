/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAIN_MENU MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit",                       IDCANCEL
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "Configuration &Settings...",  IDC_CONFIG
        MENUITEM "Disable Library Support",     ID_DISABLE_LIB
        MENUITEM SEPARATOR
        MENUITEM "&Delete...",                  IDC_DELETE
        MENUITEM SEPARATOR
        MENUITEM "Clear Error &Log",            IDC_CLEAR_ERROR_LOG
        MENUITEM "Open Error Log",              ID_OPEN_ERRORLOG
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Show Differences Only",      ID_VIEW_SHOWDIFFERENCESONLY
        MENUITEM "Hold Compile Stats",          ID_VIEW_HOLD_COMPILE_STATS
        MENUITEM SEPARATOR
        MENUITEM "View Detailed File Info...",  IDC_SHOW_FILESTATS
    END
    POPUP "&Build"
    BEGIN
        MENUITEM "&Compile...",                 IDC_COMPILE
        MENUITEM "Rebuild Master File",         IDC_REBUILD_MASTER_FILE
        MENUITEM "Forced Compile...",           IDC_FORCE_COMPILE
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "Create &Zip File Of Master File...", 
                                                ID_TOOLS_CREATE_ZIP_FILE
        MENUITEM SEPARATOR
        MENUITEM "Optimize Master File (Load Log Required)...", 
                                                IDC_OPTIMIZE_MASTERFILE
        MENUITEM "Optimize International Master File (US Load Log Required)", 
                                                59397
        MENUITEM "Create New Master File With Only Logged Assets (Load Log Required)...", 
                                                ID_TOOLS_CREATENEWMASTERFILEWITHONLYLOGGEDASSETS

        MENUITEM "Compact Master File...",      IDC_COMPACT_MASTER_FILE
        MENUITEM SEPARATOR
        MENUITEM "Generate File Type Log (Load Log Required)...", 
                                                ID_TOOLS_GENERATE_FILE_USAGE_FILE

        MENUITEM "Generate List Of Unused Assets (Load Log Required)...", 
                                                ID_TOOLS_GENERATELISTOFUNUSEDASSETS

        MENUITEM "Generate Log Of Master File Entries...", 
                                                ID_TOOLS_GENERATE_MASTER_FILE_LIST

        MENUITEM SEPARATOR
        MENUITEM "Dump File Info To CSV File...", IDC_DUMP_FILENAMES
        MENUITEM "Output Debug Pics",           ID_OUTPUT_DEBUG_PICS
        MENUITEM "Extract From Master File",    IDC_EXTRACT, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Mirror Library",             IDC_MIRROR_LIBRARY, GRAYED
    END
    POPUP "&Platform"
    BEGIN
        MENUITEM "&Xbox",                       ID_PLATFORM_XBOX
        MENUITEM "GC",                          ID_PLATFORM_GC
        MENUITEM "PC",                          ID_PLATFORM_PC
    END
END

IDR_POPUP_MENU MENU 
BEGIN
    POPUP "Actions"
    BEGIN
        MENUITEM "View Detailed File Info...",  IDC_SHOW_FILESTATS
        MENUITEM SEPARATOR
        MENUITEM "&Compile...",                 IDC_COMPILE
        MENUITEM "&Delete...",                  IDC_DELETE
        MENUITEM SEPARATOR
        MENUITEM "Check &Out From Library",     IDC_SYNC_DOWN, GRAYED
        MENUITEM "Check &Into Library",         IDC_SYNC_UP, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "Local &Rescan && Compile",    IDC_SCAN_AND_COMPILE
        MENUITEM "Library Rescan && Compile",   IDC_SYNC_DOWN_AND_COMPILE
        , GRAYED
        MENUITEM "Re&scan For Changes",         IDC_RESCAN
        MENUITEM SEPARATOR
        POPUP "&View"
        BEGIN
            MENUITEM "&Show Differences Only",      ID_VIEW_SHOWDIFFERENCESONLY

            MENUITEM "Hold Compile Stats",          ID_VIEW_HOLD_COMPILE_STATS

        END
        POPUP "&Platform"
        BEGIN
            MENUITEM "&Xbox",                       ID_PLATFORM_XBOX
            MENUITEM "GC",                          ID_PLATFORM_GC
            MENUITEM "PC",                          ID_PLATFORM_PC, GRAYED
        END
        MENUITEM SEPARATOR
        MENUITEM "Open Error Log",              ID_OPEN_ERRORLOG
        MENUITEM "Clear Error &Log",            IDC_CLEAR_ERROR_LOG
        MENUITEM SEPARATOR
        MENUITEM "Forced Compile...",           IDC_FORCE_COMPILE
    END
END


