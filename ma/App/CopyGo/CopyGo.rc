//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON    DISCARDABLE     "res\\CopyGo.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 192, 55
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About CopyGo"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,11,20,20
    LTEXT           "CopyGo Version 1.0",IDC_STATIC,40,10,119,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2000, Swingin' Ape Studios, Inc.",
                    IDC_STATIC,40,22,135,8
    DEFPUSHBUTTON   "OK",IDOK,76,34,40,14,WS_GROUP
END

IDD_COPYGO_DIALOG DIALOGEX 0, 0, 354, 208
STYLE DS_MODALFRAME | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | 
    WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "CopyGo"
FONT 8, "MS Sans Serif"
BEGIN
    RTEXT           "Program File:",IDC_STATIC,8,8,40,8
    EDITTEXT        IDC_PROGRAM_FILE,51,7,242,12,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_PROGRAM_BROWSE,297,7,50,14
    LTEXT           "Dependencies:",IDC_STATIC,7,54,49,8
    CONTROL         "List1",IDC_DEPENDENCIES,"SysListView32",LVS_REPORT | 
                    LVS_SINGLESEL | LVS_NOSORTHEADER | WS_BORDER | 
                    WS_TABSTOP,7,64,340,115
    PUSHBUTTON      "Add...",IDC_ADD,95,187,50,14
    PUSHBUTTON      "Remove",IDC_REMOVE,209,187,50,14
    PUSHBUTTON      "Edit...",IDC_EDIT,152,187,50,14
    RTEXT           "Arguments:",IDC_STATIC,8,24,40,8
    EDITTEXT        IDC_ARGS,51,23,242,12,ES_AUTOHSCROLL
    RTEXT           "Working Dir:",IDC_STATIC,8,40,40,8
    EDITTEXT        IDC_WKDIR,51,39,242,12,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_WKDIR_BROWSE,297,39,50,14
    RTEXT           "Version # 17",IDC_VERSION,285,195,65,8
END

IDD_DEPENDENCY DIALOG DISCARDABLE  0, 0, 303, 62
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Dependency"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,93,41,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,159,41,50,14
    RTEXT           "Source:",IDC_STATIC,7,9,38,8
    EDITTEXT        IDC_SOURCE,47,7,196,12,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_SOURCE_BROWSE,246,7,50,14
    RTEXT           "Destination:",IDC_STATIC,7,25,38,8
    EDITTEXT        IDC_DESTINATION,47,23,196,12,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_DESTINATION_BROWSE,246,23,50,14
END

IDD_COPY_PROGRESS DIALOG DISCARDABLE  0, 0, 247, 78
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Updating"
FONT 8, "MS Sans Serif"
BEGIN
    PUSHBUTTON      "Cancel",IDCANCEL,98,57,50,14
    LTEXT           "Source:",IDC_STATIC,7,10,26,8
    LTEXT           "Target:",IDC_STATIC,7,24,24,8
    LTEXT           "Static",IDC_SOURCE,34,10,206,8
    LTEXT           "Static",IDC_TARGET,34,24,206,8
    CONTROL         "Progress1",IDC_PROGRESS,"msctls_progress32",WS_BORDER,
                    13,38,221,14
END


