/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON    DISCARDABLE     "res\\WavCompile.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 235, 55
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About WavCompile"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "WavCompile Version 1.0",IDC_STATIC,40,10,119,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 2002",IDC_STATIC,40,25,119,8
    DEFPUSHBUTTON   "OK",IDOK,178,7,50,14,WS_GROUP
END

IDD_WAVCOMPILE_DIALOG DIALOGEX 0, 0, 409, 203
STYLE DS_MODALFRAME | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | 
    WS_SYSMENU
EXSTYLE WS_EX_ACCEPTFILES | WS_EX_APPWINDOW
CAPTION "Streaming Wav Compiler"
FONT 8, "MS Sans Serif"
BEGIN
    PUSHBUTTON      "Exit",IDCANCEL,208,182,50,14
    CONTROL         "List3",IDC_FILE_LIST,"SysListView32",LVS_REPORT | 
                    LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,8,23,394,112
    RTEXT           "Version # 17",IDC_VERSION,341,192,65,8
    LTEXT           "36 object(s)",IDC_NUM_FILES,10,137,97,8
    LTEXT           "Instructions: Drop *.wav files onto the application and press the 'Compile' button.",
                    IDC_STATIC,7,7,395,8
    PUSHBUTTON      "Compile",IDC_COMPILE_BUTTON,150,182,50,14
    PUSHBUTTON      "...",IDC_CHOOSE_XB_DIR,392,148,10,12
    EDITTEXT        IDC_XB_DIR,114,147,275,14,ES_AUTOHSCROLL | ES_READONLY
    RTEXT           "Xbox output directory:",IDC_STATIC,8,150,103,8
    PUSHBUTTON      "...",IDC_CHOOSE_GC_DIR,392,164,10,12
    EDITTEXT        IDC_GC_DIR,114,163,275,14,ES_AUTOHSCROLL | ES_READONLY
    RTEXT           "GameCube output directory:",IDC_STATIC,8,166,103,8
END


