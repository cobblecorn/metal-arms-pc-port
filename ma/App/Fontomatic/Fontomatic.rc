    PUSHBUTTON      "Cancel",IDCANCEL,354,58,50,14
    CONTROL         "Hardware",IDC_RADIO_HARDWARE,"Button",
                    BS_AUTORADIOBUTTON,17,16,47,10
    CONTROL         "Software",IDC_RADIO_SOFTWARE,"Button",
                    BS_AUTORADIOBUTTON,17,28,44,10
    CONTROL         "RefRast",IDC_RADIO_REFRAST,"Button",BS_AUTORADIOBUTTON,
                    17,40,42,10
    COMBOBOX        IDC_COMBO_DEVICE,117,14,287,66,CBS_DROPDOWNLIST | 
                    CBS_SORT | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_COMBO_MODE,117,34,287,168,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
    LTEXT           "Device",IDC_STATIC,88,18,24,8
